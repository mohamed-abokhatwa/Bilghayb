{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_REQUIRE_BACKEND": "1" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_REQUIRE_BACKEND": "1" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" }
    }
  }
}
