{
  "expo": {
    "name": "Bil-Ghayb",
    "slug": "bilghayb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abokhatwa.bilghayb",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "ExpoLocalization_supportsRTL": false
      },
      "requireFullScreen": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08130F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abokhatwa.bilghayb",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "forcesRTL": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08130F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D6BA7C"
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "bilghayb",
    "backgroundColor": "#08130F",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "dcc40d7e-2f09-4630-b28c-e5d5ce91c0a2"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": false,
      "forcesRTL": false
    },
    "description": "Pray for a stranger. A stranger prays for you. Free, anonymous dua exchange.",
    "githubUrl": "https://github.com/mohamed-abokhatwa/Bilghayb",
    "owner": "abokhatwa"
  }
}
